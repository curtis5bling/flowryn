{
  "name": "flowryn",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent Work Orchestration",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @flowryn/shared && npm run build -w @flowryn/api && npm run build -w @flowryn/web",
    "dev": "concurrently \"npm run dev -w @flowryn/api\" \"npm run dev -w @flowryn/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run build -w @flowryn/shared && npm run test --workspaces --if-present",
    "test:browser": "playwright test -c playwright.config.ts",
    "test:redis:m11": "tsx apps/api/test/redis-cluster.run.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "body-parser": "^2.4.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "follow-redirects": "^1.16.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "vitest": {
      "vite": "7.3.7"
    },
    "@vitejs/plugin-react": {
      "vite": "7.3.7"
    }
  }
}
